<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <RootNamespace>Espresso</RootNamespace>
    <AssemblyName>Espresso</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>

    <PackageId>Espresso.Caching</PackageId>
    <Description>A high-performance in-memory caching library for .NET: W-TinyLFU eviction, size/weight bounds, time- and per-entry-variable expiration, refresh-after-write, and async caches.</Description>
    <Authors>Mirco De Zorzi</Authors>
    <Copyright>Copyright (c) 2026 Mirco De Zorzi</Copyright>
    <PackageTags>cache;caching;in-memory;lru;w-tinylfu;caffeine;eviction;expiration</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/mircodz/Espresso</RepositoryUrl>
    <PackageProjectUrl>https://github.com/mircodz/Espresso</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Espresso.Tests" />
    <InternalsVisibleTo Include="Espresso.Benchmarks" />
    <InternalsVisibleTo Include="Espresso.Benchmarks.Comparison" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Espresso.SourceGenerator\Espresso.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

</Project>
